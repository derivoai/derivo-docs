# Derivo Docs — Environment Configuration
# Copy this file to .env.local and fill in the keys you want to use.
# All AI keys, email keys, and service keys are strictly SERVER-SIDE ONLY (never prefix them with NEXT_PUBLIC_).

# ============================================================================
# 1. Resend Transactional Email Service (https://resend.com/api-keys)
# Used for sending email verification and password reset emails.
# ============================================================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@derivo.in
RESEND_FROM_NAME=No-reply Derivo
RESEND_DOMAIN=derivo.in

# ============================================================================
# 2. AI Provider Chain (Configure ONE or MORE — automatic fallback in order)
# Default order: gemini -> openrouter -> groq -> cerebras -> mistral -> anthropic
# ============================================================================
AI_PROVIDER_ORDER=gemini,openrouter,groq,cerebras,mistral,anthropic

# Option A: Google Gemini API (Free tier via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option B: OpenRouter API (Free models available: https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option C: Groq Cloud API (Free tier available: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option D: Cerebras Cloud API (Free tier available: https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Option E: Mistral La Plateforme API (Free tier available: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Option F: Anthropic Claude API (Paid tier: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ============================================================================
# 3. GitHub REST API (Optional, Free Personal Access Token)
# Increases public GitHub API rate limits from 60 req/hr to 5,000 req/hr.
# Get it at: https://github.com/settings/tokens
# ============================================================================
GITHUB_TOKEN=

# ============================================================================
# 4. Supabase Auth & Postgres RLS (Free tier at https://supabase.com/dashboard)
# When omitted locally, Derivo uses its built-in encrypted local store (.data/derivo-db.json)
# with strict per-user Row-Level Security enforcement.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# 5. Application URL & Security
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
DERIVO_SESSION_SECRET=replace-with-32-byte-secret-in-production
MAX_PROJECTS_PER_USER=15
